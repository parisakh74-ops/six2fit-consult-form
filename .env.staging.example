# Safe-to-commit staging template. Never put Zoho credentials in VITE_* values.
VITE_APP_ENV=staging
VITE_CONSULT_SUBMIT_PATH=/api/consult/submit
VITE_ONBOARDING_BOOTSTRAP_PATH=/api/onboarding/bootstrap

# Server-only staging handoff configuration. Set these in cPanel, never as VITE_*.
SIX2FIT_STAGING_MODE=true
SIX2FIT_STAGING_STORAGE_DIR=/home/tofitcom/tmp/six2fit-staging
SIX2FIT_STAGING_TOKEN_SECRET=replace-with-at-least-32-random-characters
ONBOARDING_STAGING_BASE_URL=https://onboarding-staging.6tofit.com/
